# ---------------------------------------------------------------------------
# Copy to `.env` (or `.env.local`) and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Base URL of the Laravel API. Must include the /api prefix.
# REQUIRED unless VITE_USE_MOCKS=true.
VITE_API_URL=http://localhost:8000/api

# Serve the in-browser mock backend instead of real HTTP requests.
# Opt-in and defaults to false. MUST be false in any production build —
# src/config/env.js refuses to boot with mocks enabled in production.
VITE_USE_MOCKS=true

# Per-request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=20000

# Show the /design-preview route. Defaults to enabled outside production.
VITE_ENABLE_DESIGN_PREVIEW=true

# Optional: 'development' | 'staging' | 'production'.
# Leave unset locally; set to "production" for real builds.
# VITE_APP_ENV=production

# NOTE: VITE_ML_API_URL is intentionally absent. The Flask inference service
# must never be called from the browser — Laravel proxies it server-side so the
# model endpoint cannot be reached directly. See BACKEND_REQUIREMENTS.md §8.